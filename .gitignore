# 依赖
node_modules/
**/node_modules/

# 根目录构建产物（可安装插件包 plugins/dsh-database-console/lib 保留入库，
# 使克隆/发布零构建即可用；根 dist/ 仅为开发期 bundle，根包已 private 不发布）
dist/

# 日志与系统文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 环境变量与本地覆盖（含真实连接信息时绝不提交）
.env
.env.*
!.env.example

# TypeScript 增量构建缓存
*.tsbuildinfo

# 临时/测试残留
.tmp/
*.tmp

# 一次性 debug / probe 脚本（debug 阶段在 scripts/ 下随手写的工具；用完即删，
# 不要进版本控制。repo 已有的稳定脚本是 smoke.mjs / e2e-live.mjs）
/scripts/debug-*.mjs
/scripts/probe-*.mjs
/scripts/test-*.mjs
/scripts/inline-probe.mjs
/scripts/load-client-*.mjs
