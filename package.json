{
  "name": "@snowlocked/dsh-database-console",
  "version": "0.3.0",
  "description": "DSH 数据库工作台插件：连接 PostgreSQL / MySQL / MongoDB / SQLite / 达梦 DM，浏览表结构与数据、执行 SQL、AI 自然语言查数（注册 DB 工具供对话中的 AI 调用）。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/dsh-database-console.js",
  "exports": {
    ".": "./dist/dsh-database-console.js",
    "./client": "./dist/dsh-database-console.client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "database",
    "sql",
    "postgresql",
    "mysql",
    "mongodb",
    "sqlite",
    "dameng",
    "达梦",
    "ai"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots", "locale"],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "dmdb": "^1.0.52452",
    "mongodb": "^6.8.0",
    "mysql2": "^3.10.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
