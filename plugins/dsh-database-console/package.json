{
  "name": "@snowlocked/dsh-database-console",
  "version": "0.3.1",
  "description": "DSH 数据库工作台插件：连接 PostgreSQL / MySQL / MongoDB / SQLite / 达梦 DM，浏览表结构与数据、执行 SQL、AI 自然语言查数（注册 DB 工具供对话中的 AI 调用）。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "prepack": "node ../../build.mjs",
    "build": "node ../../build.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "dmdb": "^1.0.52452",
    "mongodb": "^6.8.0",
    "mysql2": "^3.10.0",
    "pg": "^8.11.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
